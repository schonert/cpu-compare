<section class="card overflow-hidden" data-controller="browse-selection">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-6 py-4">
    <h2 class="section-title">Ranked by workload</h2>
    <div class="flex flex-wrap items-center gap-1">
      <% workloads.each do |candidate| %>
        <%= link_to candidate.name, workload_path(candidate.key),
                    class: class_names(tab_classes(candidate)),
                    aria: { current: current_workload?(candidate) ? "true" : nil } %>
      <% end %>
    </div>
  </div>

  <% if scores.empty? %>
    <p class="px-6 py-8 text-center text-sm text-ink-muted">
      Nothing matches. Try a different search, or another workload.
    </p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-[13px]">
        <thead>
          <tr class="border-b border-line-soft">
            <th class="th-label px-6 py-2.5 text-end">#</th>
            <th class="th-label px-6 py-2.5 text-start">Processor</th>
            <th class="th-label px-6 py-2.5 text-start">
              <%= workload&.name %> &middot; <%= version&.label %>
            </th>
            <th class="th-label px-6 py-2.5 text-end">Compare</th>
          </tr>
        </thead>
        <tbody>
          <% scores.each_with_index do |score, index| %>
            <tr class="border-b border-line-soft last:border-b-0 hover:bg-sunken">
              <td class="figure px-6 py-3 text-end text-ink-faint"><%= rank_for(index) %></td>
              <td class="px-6 py-3">
                <span class="flex items-center gap-2">
                  <%= render VendorDotComponent.new(vendor: score.cpu.vendor) %>
                  <span class="font-medium text-ink"><%= score.cpu.name %></span>
                </span>
              </td>
              <td class="px-6 py-3">
                <%# Value, units, sample count, version, date and source — all
                    of it, on every row. %>
                <%= render FigureComponent.new(score: score) %>
              </td>
              <td class="px-6 py-3 text-end">
                <% unless selected?(score.cpu) || full? %>
                  <%= link_to "Add", add_path(score.cpu),
                              data: { action: "click->browse-selection#add" },
                              class: "rounded-md bg-sunken px-3 py-1 text-[12px] font-medium text-ink hover:bg-ink hover:text-panel" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
