<section class="card mt-3 overflow-hidden">
  <div class="border-b border-line px-5 py-4">
    <h2 class="eyebrow text-accent">Specifications</h2>
  </div>

  <% if empty? %>
    <p class="px-5 py-5 text-[13px] leading-relaxed text-ink-muted">
      No specifications on record for these processors. Core and thread counts are read
      back out of the benchmark runs themselves; everything else comes from Wikidata,
      which covers only a few hundred CPU models. A processor having scores but a thin
      spec sheet is normal here.
    </p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-[13px]">
        <thead>
          <tr class="border-b border-line-soft">
            <th class="eyebrow px-5 py-2.5 text-start text-ink-faint">Specification</th>
            <% cpus.each do |cpu| %>
              <th class="px-5 py-2.5 text-start font-semibold text-ink">
                <span class="flex items-center gap-2">
                  <%= render VendorDotComponent.new(vendor: cpu.vendor) %>
                  <%= cpu.name %>
                </span>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr class="border-b border-line-soft last:border-b-0">
              <th class="px-5 py-2.5 text-start font-normal text-ink-muted"><%= row.label %></th>
              <% cpus.each do |cpu| %>
                <td class="px-5 py-2.5 align-top"
                    data-cpu-slug="<%= cpu.slug %>"
                    data-compare-highlight-target="item">
                  <span class="figure font-semibold text-ink"><%= cell_value(row, cpu) %></span>
                  <% if (label = source_label(row, cpu)) %>
                    <span class="eyebrow mt-0.5 block text-ink-faint">
                      <% if (url = source_url(row, cpu)) %>
                        <%= link_to label, url, class: "hover:text-ink-muted underline underline-offset-2",
                                    rel: "noopener", target: "_blank" %>
                      <% else %>
                        <%= label %>
                      <% end %>
                      <% if (samples = sample_label(row, cpu)) %>
                        <span class="ms-1"><%= samples %></span>
                      <% end %>
                    </span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
