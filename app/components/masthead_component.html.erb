<header class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="eyebrow mb-2 text-accent">Blender Open Data</p>
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">CPU compare</h1>
    <p class="mt-2 max-w-[48ch] text-sm text-ink-muted">
      Median benchmark results for <%= number_with_delimiter(Catalogue.size) %> processors,
      per workload, each traceable to the runs behind it.
    </p>
  </div>

  <nav class="flex gap-1 rounded-full bg-panel p-1" aria-label="View">
    <% MODES.each do |tab| %>
      <%= link_to tab[:label], path_for(tab[:key]),
                  class: tab_classes(tab[:key]),
                  aria: { current: ("page" if current?(tab[:key])) } %>
    <% end %>
  </nav>
</header>
