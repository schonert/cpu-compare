<header class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-4xl font-emphasis">CPU compare</h1>
    <p class="mt-2 max-w-[48ch] text-[15px] leading-relaxed text-ink-muted">
      Median benchmark results for <%= number_with_delimiter(Catalogue.size) %> processors,
      per workload, each traceable to the runs behind it.
    </p>
  </div>

  <nav class="flex gap-1 rounded-lg bg-sunken p-1" aria-label="View">
    <% MODES.each do |tab| %>
      <%= link_to tab[:label], path_for(tab[:key]),
                  class: tab_classes(tab[:key]),
                  aria: { current: ("page" if current?(tab[:key])) } %>
    <% end %>
  </nav>
</header>
