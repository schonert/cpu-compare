<section class="border-t border-line px-6 py-5 first:border-t-0">
  <div class="mb-3.5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-sm font-strong text-ink"><%= workload.name %></h3>
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
      <p class="text-xs text-ink-faint"><%= chart.direction_note %></p>
      <% if scale_label %><p class="text-xs text-ink-faint"><%= scale_label %></p><% end %>
    </div>
  </div>

  <ul class="space-y-3">
    <% bars.each do |bar| %>
      <%# Name, bar and value on one row. Keeping the value out of the bar
          column is what lets every bar start and end on the same x-positions,
          so their lengths can be read against each other. %>
      <li class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4
                 transition-opacity duration-150 sm:grid-cols-[13rem_minmax(0,1fr)_8rem]"
          data-cpu-slug="<%= bar.cpu.slug %>"
          data-compare-highlight-target="item"
          data-action="mouseenter->compare-highlight#highlight mouseleave->compare-highlight#clear focus->compare-highlight#highlight blur->compare-highlight#clear"
          tabindex="0">
        <span class="flex min-w-0 items-center gap-2">
          <%= render VendorDotComponent.new(vendor: bar.cpu.vendor) %>
          <span class="<%= class_names(name_classes(bar)) %>" title="<%= bar.cpu.name %>">
            <%= bar.cpu.name %>
          </span>
        </span>

        <% if bar.missing? %>
          <%# Said plainly rather than drawn as a zero-length bar: no figure
              means too few runs to publish, not a slow chip. %>
          <span class="col-span-2 text-xs text-ink-faint sm:col-span-2 sm:col-start-2">
            Fewer than <%= Scoring::Config.current.min_samples %> runs on record — not published
          </span>
        <% else %>
          <%# Track and fill share one tick grid, so filled ticks land exactly
              on the empty ones and the bar reads as a scale, not a smear. %>
          <div class="relative order-last col-span-2 h-5 sm:order-none sm:col-span-1 sm:col-start-2">
            <div class="ticks absolute inset-0 text-track" aria-hidden="true"></div>
            <div class="ticks absolute inset-y-0 start-0 <%= tick_ink(bar) %>"
                 style="width: <%= bar.percent %>%" aria-hidden="true"></div>
          </div>

          <span class="<%= class_names(value_classes(bar)) %> sm:col-start-3">
            <%= link_to score_value(bar.score), measurements_path(bar.score),
                        class: "underline decoration-line decoration-1 underline-offset-4 hover:decoration-accent",
                        title: "See the runs behind this figure" %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
