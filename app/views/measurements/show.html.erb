<% content_for :title, "#{@score.cpu.name} — #{@score.workload.name}" %>

<article class="card overflow-hidden">
  <div class="border-b border-line px-6 py-6">
    <p class="eyebrow mb-2 text-ink-muted">Measurements behind one figure</p>
    <h1 class="text-3xl font-strong">
      <%= @score.cpu.name %>
    </h1>
    <p class="mt-1 text-[15px] text-ink-muted">
      <%= @score.workload.name %> &middot; <%= @score.benchmark_version.label %> &middot;
      <%= @score.benchmark_version.benchmark_suite.name %>
    </p>
  </div>

  <%# The figure restated with its full spread, so the page that justifies a
      number opens by showing exactly what was claimed. %>
  <dl class="grid grid-cols-2 gap-px bg-line sm:grid-cols-4">
    <% [["Median", "#{score_value(@score)}"],
        ["Samples", number_with_delimiter(@score.sample_count)],
        ["IQR", @score.iqr ? "#{number_with_precision(@score.iqr, precision: 1)} #{@score.metric_unit}" : "—"],
        ["Range", "#{number_with_precision(@score.minimum, precision: 1)} – #{number_with_precision(@score.maximum, precision: 1)}"]].each do |label, value| %>
      <div class="bg-panel px-6 py-4">
        <dt class="th-label"><%= label %></dt>
        <dd class="figure mt-1 text-lg font-strong text-ink"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <div class="border-t border-line px-6 py-4 text-[13px] text-ink-muted">
    <p>
      Aggregated with the <%= Scoring::Config.current.statistic %>, quantiles by
      <%= Scoring::Config.current.quantile_method.tr("_", " ") %>.
      Suppressed below <%= @score.min_samples %> samples; this figure has
      <%= number_with_delimiter(@score.sample_count) %>.
      Scoring rules version <%= @score.scoring_config_version %>.
      <%= link_to "Methodology", methodology_path, class: "underline underline-offset-2 hover:text-ink" %>
    </p>
    <% if @excluded.any? %>
      <p class="mt-2">
        <%# So the sample count reconciles against the raw data rather than
            appearing to lose rows silently. %>
        Also recorded but not aggregated:
        <%= @excluded.map { |reason, count| "#{number_with_delimiter(count)} #{reason.tr('_', ' ')}" }.to_sentence %>.
      </p>
    <% end %>
  </div>
</article>

<section class="card mt-6 overflow-hidden">
  <div class="border-b border-line px-6 py-5">
    <h2 class="section-title">
      Individual runs
      <span class="ms-2 text-xs font-normal text-ink-faint"><%= number_with_delimiter(@total) %> total</span>
    </h2>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full border-collapse text-[13px]">
      <thead>
        <tr class="border-b border-line-soft">
          <% ["Measured", "Value", "Build", "Cores", "Threads", "OS", "Reported as"].each do |head| %>
            <th class="th-label px-6 py-2.5 text-start"><%= head %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @submissions.each do |submission| %>
          <tr class="border-b border-line-soft last:border-b-0">
            <td class="figure px-6 py-2 text-ink-muted"><%= submission.measured_at&.to_date %></td>
            <td class="figure px-6 py-2 font-strong text-ink">
              <%= number_with_precision(submission.value, precision: 2) %>
              <span class="text-xs font-normal text-ink-muted"><%= submission.metric_key == "render_time_seconds" ? "s" : "samples/min" %></span>
            </td>
            <td class="px-6 py-2 text-ink-muted"><%= submission.benchmark_build %></td>
            <td class="figure px-6 py-2 text-ink-muted"><%= submission.system_cores %></td>
            <td class="figure px-6 py-2 text-ink-muted"><%= submission.device_threads %></td>
            <td class="px-6 py-2 text-ink-muted"><%= submission.operating_system %></td>
            <%# The raw OS string, so a mis-normalised name is visible rather
                than hidden behind the canonical one. %>
            <td class="px-6 py-2 text-ink-faint"><%= submission.raw_device_name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<%= render PaginationComponent.new(page: @page, total: @total,
                                   per_page: MeasurementsController::PER_PAGE,
                                   path: ->(page) { measurements_path(@score, page: page) }) %>
