<% @mode = "browse" %>
<% content_for :title, "Browse processors" %>
<% @selected_slugs = @selected %>

<%= render FilterBarComponent.new(filters: @filters, selected: @selected,
                                  version: @version&.to_param, workload: @workload&.key) %>

<div class="card mt-6 px-6 py-5">
  <%= render VersionPickerComponent.new(versions: Catalogue.versions, current: @version,
                                        path: ->(version) {
                                          cpus_path(@filters.merge(
                                            version: version.to_param, workload: @workload&.key,
                                            cpus: @selected.join(",").presence).compact)
                                        }) %>
</div>

<div class="mt-6">
  <%= render CpuTableComponent.new(scores: @scores, version: @version, workload: @workload,
                                   filters: @filters, selected: @selected,
                                   offset: (@page - 1) * CpusController::PER_PAGE) %>
</div>

<%= render PaginationComponent.new(page: @page, total: @total, per_page: CpusController::PER_PAGE,
                                   path: ->(page) { cpus_path(@filters.merge(
                                     page: page, version: @version&.to_param,
                                     workload: @workload&.key,
                                     cpus: @selected.join(",").presence).compact) }) %>
